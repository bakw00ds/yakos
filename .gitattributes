# Treat vendored JS blobs as binary so git never applies EOL normalization
# or diff text-heuristics to them.  The SHA-256 pinned in
# cli-go/internal/consoleui/vendor_checksum_test.go is over the exact raw
# bytes; any EOL conversion (e.g. autocrlf on Windows) would corrupt the
# hash and fail TestVendorChecksums on windows-latest CI.
cli-go/internal/consoleui/dist/vendor/*.min.js binary
# Monaco editor vendored blobs — same rationale; treat all Monaco JS and
# binary assets as binary to avoid checksum corruption on Windows.
# The glob covers the full min/vs tree (basic-languages/*, language/*, etc.).
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.js binary
# Files directly under min/vs/ (e.g. loader.js, nls.messages.*.js) are not
# matched by the **/*.js glob above; enumerate the shallow level explicitly.
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/*.js binary
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.css binary
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.ttf binary
# CHECKSUMS.sha256 manifest — treat as binary so line endings cannot
# corrupt the hex digests on Windows (sha256sum expects LF).
cli-go/internal/consoleui/dist/vendor/monaco/CHECKSUMS.sha256 binary
