# Treat vendored JS blobs as binary so git never applies EOL normalization
# or diff text-heuristics to them.  The SHA-256 pinned in
# cli-go/internal/consoleui/vendor_checksum_test.go is over the exact raw
# bytes; any EOL conversion (e.g. autocrlf on Windows) would corrupt the
# hash and fail TestVendorChecksums on windows-latest CI.
cli-go/internal/consoleui/dist/vendor/*.min.js binary
# Monaco editor vendored blobs — same rationale; treat all Monaco JS and
# binary assets as binary to avoid checksum corruption on Windows.
# The glob covers the full min/vs tree (basic-languages/*, language/*, etc.).
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.js binary
# Files directly under min/vs/ (e.g. loader.js, nls.messages.*.js) are not
# matched by the **/*.js glob above; enumerate the shallow level explicitly.
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/*.js binary
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.css binary
cli-go/internal/consoleui/dist/vendor/monaco/min/vs/**/*.ttf binary
# CHECKSUMS.sha256 manifest — treat as binary so line endings cannot
# corrupt the hex digests on Windows (sha256sum expects LF).
cli-go/internal/consoleui/dist/vendor/monaco/CHECKSUMS.sha256 binary
# PandaOS-ported vendored fonts (Inter + JetBrains Mono woff2) — binary
# to avoid EOL conversion corrupting woff2 binary content and SHA-256 pins.
# The files live under dist/vendor/fonts/ (populated at font-vendoring time;
# see VENDOR.md §Fonts for the download + hash recipe).
cli-go/internal/consoleui/dist/vendor/fonts/*.woff2 binary
# Drawflow drag/connect visual node editor — same binary treatment as Mermaid.
# SHA-256 pinned in vendor_checksum_test.go + VENDOR.md.
cli-go/internal/consoleui/dist/vendor/drawflow/drawflow.min.js binary
cli-go/internal/consoleui/dist/vendor/drawflow/drawflow.min.css binary
# xterm.js terminal emulator (ADR-0008 Phase 1 Terminal pane).
# SHA-256 pinned in vendor_checksum_test.go + VENDOR.md.
cli-go/internal/consoleui/dist/vendor/xterm/xterm.js binary
cli-go/internal/consoleui/dist/vendor/xterm/xterm-addon-fit.js binary
cli-go/internal/consoleui/dist/vendor/xterm/xterm.css binary

# Golden settings.json compared byte-for-byte by internal/refresh tests;
# autocrlf on Windows would turn them CRLF and fail the comparison.
cli-go/internal/refresh/testdata/golden-bash/* binary

# Refresh fixture settings.json files are inputs whose bytes flow into the
# output when refresh sees them in sync; keep them LF on Windows too.
cli-go/cmd/yakos/testdata/fixtures/refresh/*/.claude/settings.json text eol=lf

# K-110: the invalid-UTF-8 fixture must keep its raw bytes on every platform.
tests/fixtures/hooks/yakos-invalid-utf8.yml binary
# Specialist rules are hashed (sha256 marker) and copied into projects by
# `yakos refresh`; force LF so a Windows autocrlf checkout cannot make every
# refresh report drift (K-116). Installed copies and fixtures are LF too.
lib/rules/*.md text eol=lf
tests/fixtures/refresh/**/.claude/rules/*.md text eol=lf
cli-go/cmd/yakos/testdata/fixtures/refresh/**/.claude/rules/*.md text eol=lf

# Model registry (K-138). The embedded catalog is compared with the lib copy byte
# for byte, and the CLI goldens with the printed output; force LF so a Windows
# autocrlf checkout cannot turn either compare into a CRLF mismatch.
lib/settings/model-catalog.json text eol=lf
cli-go/internal/modelreg/model-catalog.json text eol=lf
cli-go/internal/modelreg/testdata/* text eol=lf
cli-go/cmd/yakos/testdata/models-*.golden text eol=lf

# Byte-exact test fixtures (K-132). The cache-stability golden is compared with
# the generated --agents JSON byte for byte, and the routing reader's fixtures
# are compared with the bash reader's reading of the same bytes. Force LF so a
# Windows autocrlf checkout cannot turn the compare into a CRLF mismatch.
cli-go/internal/agentscompose/testdata/cachestable/** text eol=lf
cli-go/internal/projectcfg/testdata/*.yml text eol=lf

# Cost goldens and ledger fixtures (K-136). `yakos cost` output is compared
# with these byte for byte, and the bash twin reads the compat log. Force LF so
# a Windows autocrlf checkout cannot turn the compare into a CRLF mismatch.
cli-go/cmd/yakos/testdata/fixtures/cost/*.golden text eol=lf
cli-go/cmd/yakos/testdata/fixtures/cost/ledger-*.ndjson text eol=lf
tests/fixtures/ledger-compat/* text eol=lf

# Frozen routing golden (generated once at base 24f0a6ba); compared byte for byte.
cli-go/internal/dispatch/testdata/route_p0a_golden.txt text eol=lf

# Router explain goldens (K-139b): `yakos router explain` output compared byte for
# byte; force LF so a Windows autocrlf checkout cannot make the compare fail.
cli-go/cmd/yakos/testdata/router-explain/*.golden text eol=lf
cli-go/internal/doctor/testdata/*.golden text eol=lf
cli-go/cmd/yakos/testdata/router-policy/*.golden text eol=lf
