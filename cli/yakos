#!/usr/bin/env bash
# yakos — entry point for the YakOS CLI.
#
# Dispatches to cli/lib/<subcommand>.sh. Sources compat.sh so subcommands
# inherit the ct_* helpers.

set -eu

# Resolve YAKOS_ROOT — the directory containing this script's parent.
# We don't rely on `realpath` here since compat.sh isn't loaded yet; we use
# a portable bash recipe that works on macOS bash 3.2 too.
__yakos_self="${BASH_SOURCE[0]:-$0}"
__yakos_self_dir="$(cd "$(dirname -- "$__yakos_self")" && pwd -P)"
YAKOS_ROOT="$(cd "$__yakos_self_dir/.." && pwd -P)"
YAKOS_LIB="$YAKOS_ROOT/cli/lib"
export YAKOS_ROOT YAKOS_LIB

# shellcheck source=cli/lib/compat.sh
. "$YAKOS_LIB/compat.sh"

VERSION_FILE="$YAKOS_ROOT/VERSION"
if [ -r "$VERSION_FILE" ]; then
    YAKOS_VERSION="$(cat "$VERSION_FILE")"
else
    YAKOS_VERSION="unknown"
fi
export YAKOS_VERSION

usage() {
    cat <<EOF
yakos $YAKOS_VERSION — multi-project agent framework for Claude Code

Usage:
    yakos <command> [args...]
    yakos --version | -v
    yakos --help    | -h

Install / lifecycle:
    install       Install YakOS into ~/.claude (per-file symlinks +
                  safe settings.json merge)
    uninstall     Remove YakOS-owned symlinks. Auto-memory at
                  ~/.claude/projects/ is NEVER touched.
    update        git pull on the framework + refresh symlinks; reports
                  changed files and applied commits.
    doctor        Verify install + environment health.
                  Args: [<project-path>] [--probe-runtime]
    --version     Print the version
    --help        Print this help

Project bootstrap / launch / inspection:
    init          Bootstrap a project's ~/agent-control/<name>/
                  Args: <name> --project <path> [--force] [--with-gate]
    start         Launch a session for a bootstrapped project (claude / codex / gemini).
                  Args: [<name>] [--runtime <id>] [--safe] [--dry-run]
                        [--continue|--resume <id>] [--ide] [--bare]
                        [--model <alias>] [--strict-mcp]
                  Materializes agents in the runtime's native format
                  (claude: --agents JSON; codex: TOML files; gemini: md
                  files) and exec's the chosen runtime CLI.
    auth          Per-runtime auth: status / login / logout / set-default.
                  Args: status [<runtime>] | login <runtime> [--as-default]
                        | logout <runtime> | set-default <runtime>
    dispatch      One-shot cross-runtime agent dispatch (v0.4.2+).
                  Args: <agent-name> "<task>" [--runtime <id>]
                        [--project <path>] [--timeout <secs>]
                  Reads agent frontmatter `runtime:` to pick the CLI;
                  --runtime overrides. Honors `runtime-fallback:` list
                  if the preferred runtime is unavailable. Captures
                  stdout + token usage; returns rc.
    hooks         Translate yakOS hooks to runtime-native config (v0.5+).
                  Args: install <runtime> --project <path> | status [<path>]
    memory        Portable yakOS memory across runtimes (v0.5+).
                  Args: list | show <key> | put <key> <file> | sync <runtime>
    agent / agents
                  Agent file lifecycle (v0.6+).
                  Args: new <name> --runtime <id> [--extends <id>] | lint
                  `agents` is a plural alias for the lint subcommand.
    cost          Aggregate dispatch-log telemetry into a per-runtime / per-agent
                  cost report (v0.6+).
                  Args: [--since <ISO>] [--by agent|runtime|day]
    session       Session lifecycle export + listing (v0.7+).
                  Args: export <project> [<tag>] | list <project>
    soul          Operator-personal soul files spliced into lead prompt (v0.12+).
                  Args: show|edit|history|revert|pending|approve|reject ...
    retro         Manage 10-cycle retrospectives (v0.12+).
                  Args: now | last | history | status | disable | enable
    validate      Schema + reference validation (framework or project)
                  Args: [<project-path>] [--all]
    archive       Roll work/current/ into work/archive/<tag>/
    status        Per-project dashboard
    team          Team lifecycle (e.g. 'yakos team restart <project>')

Release / version:
    version-bump  Bump VERSION + prepend CHANGELOG entry (and commit).
                  Promotes [Unreleased] when it has substantive content.
                  Args: --component {major|minor|patch|hotfix}
                        [--message <text>] [--no-commit]
    git-hooks     Install / uninstall / status the pre-push version gate.
                  Args: install | uninstall | status [--force]

Examples:
    yakos install
    yakos doctor
    yakos uninstall
    yakos init myapp --project ~/code/myapp
    yakos start myapp                     # explicit
    yakos                                 # auto-detect from cwd
    yakos start myapp --safe              # prompts on
    yakos version-bump --component patch --message "fix: stale doctor message"
    yakos git-hooks install   # in current project repo

The framework lives at:  $YAKOS_ROOT
EOF
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then
    shift
fi

# Bare-yakos autodetect: if invoked with no args, infer what the operator
# wants from the current directory. Three contexts:
#   1. Inside ~/agent-control/<name>/  → start a session for <name>.
#   2. Inside a yakos-bootstrapped project repo (matches a control dir's
#      .project-path) → start a session for the matching <name>.
#   3. Inside a git repo without bootstrap → suggest `yakos init`.
#   4. Anywhere else → print full usage (current behavior).
if [ -z "$cmd" ]; then
    cwd_real="$(cd "$PWD" 2>/dev/null && pwd -P)"
    ac_root="$HOME/agent-control"
    detected_name=""
    detected_reason=""

    case "$cwd_real" in
        "$ac_root"/*)
            rest="${cwd_real#$ac_root/}"
            detected_name="${rest%%/*}"
            detected_reason="cwd is ~/agent-control/$detected_name"
            ;;
    esac

    if [ -z "$detected_name" ] && [ -d "$ac_root" ]; then
        for cd_path in "$ac_root"/*/.project-path; do
            [ -f "$cd_path" ] || continue
            proj="$(head -1 "$cd_path" 2>/dev/null)"
            proj_real="$(cd "$proj" 2>/dev/null && pwd -P || true)"
            [ -n "$proj_real" ] || continue
            case "$cwd_real" in
                "$proj_real"|"$proj_real"/*)
                    detected_name="$(basename -- "$(dirname -- "$cd_path")")"
                    detected_reason="cwd is inside the project repo for '$detected_name'"
                    break
                    ;;
            esac
        done
    fi

    if [ -n "$detected_name" ]; then
        echo "yakos: detected project '$detected_name' ($detected_reason)" >&2
        echo "       launching session..." >&2
        echo >&2
        bash "$YAKOS_LIB/start.sh" "$detected_name"
        exit $?
    fi

    if [ -d "$cwd_real/.git" ] || git -C "$cwd_real" rev-parse --git-dir >/dev/null 2>&1; then
        cat >&2 <<EOF
yakos: this looks like a git repo but is not bootstrapped for yakos.

To bootstrap (creates ~/agent-control/<name>/, copies hooks, drops settings):
    yakos init <name> --project $cwd_real

Then start a session:
    yakos start <name>

(Or run 'yakos --help' for the full command list.)
EOF
        exit 0
    fi

    usage
    exit 0
fi

case "$cmd" in
    -h | --help | help)
        usage
        ;;
    -v | --version)
        echo "yakos $YAKOS_VERSION"
        ;;
    install | uninstall | update | init | doctor | validate | archive | status | team | start | auth | dispatch | memory | agent | cost | session | migrate | plugin | teach | soul | retro)
        script="$YAKOS_LIB/${cmd}.sh"
        if [ ! -f "$script" ]; then
            ct_die "internal error: $script not found"
        fi
        # Run the subcommand in a child bash so subcommand `set -e` etc.
        # doesn't bleed into the dispatcher.
        bash "$script" "$@"
        ;;
    version-bump)
        bump_script="$YAKOS_ROOT/lib/skills/version-bump/scripts/bump.sh"
        if [ ! -x "$bump_script" ]; then
            ct_die "version-bump skill not found or not executable at $bump_script; run 'yakos doctor'"
        fi
        bash "$bump_script" "$@"
        ;;
    git-hooks)
        script="$YAKOS_LIB/git-hooks.sh"
        if [ ! -f "$script" ]; then
            ct_die "internal error: $script not found"
        fi
        bash "$script" "$@"
        ;;
    hooks)
        script="$YAKOS_LIB/hooks-install.sh"
        if [ ! -f "$script" ]; then
            ct_die "internal error: $script not found"
        fi
        bash "$script" "$@"
        ;;
    agents)
        # 'agents' is a plural alias for 'agent' to make `yakos agents lint` natural.
        bash "$YAKOS_LIB/agent.sh" "$@"
        ;;
    *)
        echo "yakos: unknown command '$cmd'" >&2
        echo >&2
        usage >&2
        exit 64  # EX_USAGE
        ;;
esac
