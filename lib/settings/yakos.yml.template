# Project-level yakOS configuration. Read at session start by the lead
# (rule:profile-standards). Operator-editable.
#
# Generated by `yakos init`. Schema documented in:
#   - lib/rules/profile-standards.md (active-standards behavior)
#   - cross-project-standards-plan.md §2 (per-standard wiring)
#   - lib/rules/environment-discipline.md (environments block)

yakos: 0.9

# ---- runtime preferences (optional) ----------------------------------------
# Pinned per-agent via agent frontmatter; .yakos.yml provides project defaults.
#
# default-runtime: claude
# default-fallback: [claude]
# per-domain:
#   backend: claude
#   ui: agy

# ---- project profile (Plan 4 / v0.18+) -------------------------------------
# Profile type drives auto-suggested standards. Operator opts in/out per
# standard. Set `standards.<name>: true` to commit the project to that
# standard; release-audit will enforce + scaffolds will drop in starter code.
#
# Profile types:
#   web-app        — full-stack with UI; suggests logging, changelog-ui,
#                    monitors, feedback, architecture-viz, about-page
#   service        — headless; suggests logging, monitors, architecture-viz
#   library        — reusable code; suggests architecture-viz, about-page
#   cli-tool       — terminal tool; suggests logging, about-page
#   data-pipeline  — batch / streaming; suggests logging, monitors
#
# Edit the type and standards map below to match the project.

profile:
  type: web-app
  standards:
    logging: false           # Standard 1 — structured service logs
    changelog-ui: false      # Standard 2 — version + CHANGELOG visible in UI
    monitors: false          # Standard 3 — supervisor configs + /healthz
    feedback: false          # Standard 4 — panda-os3.0-style feedback system
    architecture-viz: false  # Standard 5 — architecture page in UI
    about-page: false        # Standard 6 — about page for new users

  # Per-standard config overrides (optional; defaults are sensible).
  # logging:
  #   format: json
  #   levels: [debug, info, warn, error]
  # monitors:
  #   targets: [api, worker]
  # changelog-ui:
  #   component_path: web/src/components/Changelog.tsx

# ---- budget guardrails (v0.34+) --------------------------------------------
# Per-session caps enforced by budget-guard.sh (PreToolUse hook).
# Any cap exceeded blocks the next tool call until the operator either
# adds a bypass entry, raises the cap, or starts a new session.
#
# Defaults below are conservative; tune for your workflow. All caps
# optional; omitting one means no enforcement for that dimension.
#
# Emergency disable: export YAKOS_BUDGET_DISABLE=1
#
# budget:
#   enabled: true
#   max_tool_calls: 500             # session-wide
#   max_wall_seconds: 7200          # 2 hours
#   max_repeat_same_tool: 8         # loop detection — same tool in a row
#
# Bypass example in work/current/hook-bypass.md:
#   **Hook:** budget
#   **Scope:** cap=max_tool_calls
#
# Reference: https://www.infoworld.com/article/4138748/finops-for-agents

# ---- context injection (v0.35+) --------------------------------------------
# UserPromptSubmit hook that surfaces recent session context before
# each prompt: decisions.md tail, budget remaining, peer-status,
# recent supervisor CRITICAL. All sections individually toggleable.
# DEFAULT OFF — opt in to avoid surprise context bloat.
#
# context_inject:
#   enabled: true
#   inject_decisions: true       # tail of decisions.md
#   inject_budget: true          # if budget block configured
#   inject_peers: true           # if multi-dev coord enabled
#   inject_supervisor: true      # most recent CRITICAL finding

# ---- output-injection scanner (v0.34+) -------------------------------------
# PostToolUse hook that scans tool output (Bash/Read/WebFetch/mcp__*)
# for known prompt-injection patterns. Detection only — never blocks.
# See lib/playbooks/09-prompt-injection-defense.md.
#
# injection_scan:
#   enabled: true     # set to false to disable

# ---- supervisor mode (v0.34+, Option 2 redesign) ----------------------------
# A live shadow agent that watches the lead's mutation tool calls and judges
# drift / accuracy / intent. v0.34 adds a local shell-only pre-filter that
# runs before any LLM dispatch, cutting ~80% of scoring events.
#
# Architecture: matcher (Edit|Write|MultiEdit|Bash) → pre-filter → escalation
# counter → async LLM dispatch → supervisor-gate.sh deterministic block.
#
# Disabled by default — opt in by flipping enabled to true.
#
# supervisor:
#   enabled: true
#   runtime: claude                # which runtime to dispatch supervisor on
#   agent: supervisor              # agent file id (rarely overridden)
#   score_every_n_calls: 10        # cost vs latency tradeoff (escalations only)
#   block_on_critical: true        # active mode; false = surface-only
#   model: haiku                   # haiku | sonnet | opus (override tier)
#   #
#   # matcher: "Edit|Write|MultiEdit|Bash"  # default; set to "*" for verbose mode
#   # (The matcher in .claude/settings.json is what Claude Code actually uses.
#   #  This key is for documentation; 'yakos init' templates it into settings.json.)
#   #
#   # pre_filter:
#   #   enabled: true              # set to false to revert to pre-v0.34 behavior
#   #   min_diff_lines: 20         # diff > this many lines → escalate
#   #   risk_regex:                # additional patterns beyond the built-in list
#   #     - "drop\\s+table"
#   #     - "force.*push"
#   #     - "rm\\s+-rf"
#   #
#   # Built-in risk_regex patterns (always active when pre_filter.enabled: true):
#   #   drop[[:space:]]+table
#   #   force.*push
#   #   rm[[:space:]]+-rf
#   #   chmod[[:space:]]+777
#   #   (password|secret|api_key|token) = <long-non-env-value>
#   #
#   # Future: supervisor.runtime: local-llm → Ollama integration (TODO in
#   # supervisor-stream.sh; local-llm runtime is a no-op placeholder for now)
#
# Emergency bypass (any session):
#   export YAKOS_SUPERVISOR_DISABLE=1

# ---- supervisor escalation gate (v0.34+) -----------------------------------
# Blocks TeamCreate and Agent dispatches when the supervisor has written
# a finding with recommended_action: surface_to_operator, block_next_tool,
# or halt that has not yet been acknowledged by the operator.
#
# Operator acknowledgement: yakos supervise ack <finding-id> [--note "..."]
# List pending:             yakos supervise pending
# Ack all:                  yakos supervise ack-all [--note "..."]
# Ack state:                ~/.yakos-state/supervisor-acks.ndjson (append-only)
#
# Default: ON (gate is active when supervisor mode is in use).
# Per-project opt-out:
#
# supervise:
#   gate_on_escalation: true   # set to false to disable the ack gate for this project

# ---- plan quality gate (v0.X+) ---------------------------------------------
# PostToolUse hook that auto-scores work/current/plan.md on every write,
# using the 3-judge cross-vendor panel from the plan-quality-eval skill.
# Operator CLI: yakos plan score show | history | override <plan_id> --reason "..."
# See lib/skills/plan-quality-eval/SKILL.md for rubric + scoring details.
#
# plan_quality:
#   enabled: true            # set to false to disable auto-scoring entirely
#   mode: surface            # surface: notify only | block: block next dispatch
#   threshold: 0.75          # weighted aggregate pass threshold (0..1)
#   cost_ceiling_usd: 0.15   # hard cost ceiling per scoring run

# ---- environment workflows (Plan 3 M5 / v0.17+) ----------------------------
# Uncomment + customize to enable dev→test→prod promotion gates.
#
# environments:
#   dev:
#     branch: develop
#   test:
#     branch: staging
#     promotes_from: [dev]
#   prod:
#     branch: main
#     promotes_from: [test]
#     requires_review: true
