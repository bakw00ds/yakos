# macOS
.DS_Store
._*

# Claude Code internals
.claude/scheduled_tasks.lock
.claude/projects/

# Editor backups & temp
*~
*.swp
*.swo
*.tmp
*.bak

# YakOS settings backups (created at install time in $HOME, not in this repo,
# but list anyway in case anyone runs install with HOME=this repo)
*.yakos-bak-*

# Test scratch
/tmp-test-home/

# yakOS — runtime-emitted agent files (added by doctor --fix)
.codex/agents/yakos-*.toml
.gemini/agents/yakos-*.md
.gemini/settings.json.yakos-bak-*

# yakOS — runtime-emitted agent files (v0.4.0+)
.agents/skills/yakos-*.md
.agents/mcp_config.json
.agents/hooks.json

# Local / per-machine state — never tracked
.claude/settings.local.json
.claude/worktrees/
.antigravitycli/
cli/lib/mcp/.venv/

# Go build outputs
/cli-go/yakos
/cli-go/yakos.exe
/cli-go/*.test.exe
/bin/yakos

# Embedded framework lib — staged by `make embed-lib`, NOT committed.
# The per-subdir .gitignore files also enforce this, but add a root-level
# safety net covering the entire staged tree.
# Only .keep placeholder files and the per-dir .gitignore are tracked.
/cli-go/internal/framework/embedded/agents/*
!/cli-go/internal/framework/embedded/agents/.keep
/cli-go/internal/framework/embedded/skills/*
!/cli-go/internal/framework/embedded/skills/.keep
/cli-go/internal/framework/embedded/rules/*
!/cli-go/internal/framework/embedded/rules/.keep
/cli-go/internal/framework/embedded/hooks/*
!/cli-go/internal/framework/embedded/hooks/.keep
/cli-go/internal/framework/embedded/playbooks/*
!/cli-go/internal/framework/embedded/playbooks/.keep

# Agent-control runtime scratchpad (work/current/... tree)
/work/

# Machine-local MCP config (hardcodes absolute user paths)
/.mcp.json
